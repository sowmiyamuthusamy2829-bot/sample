pipeline{
    agent any 
    stages{
        stage ('clone code'){
            steps{
            git branch:'main',
            url:'https://github.com/sowmiyamuthusamy2829-bot/sample.git'
            }
        }
        stage ('compile code'){
        steps{
            bat 'javac demo.java'
             }
        }
        stage('run code'){
            steps{
                bat 'java demo'
            }
        }
        
    }
}
